# Copy to .env and fill in. .env is git-ignored.

# Meta Model API (https://dev.meta.ai)
MODEL_API_KEY=
META_API_BASE=https://api.meta.ai/v1

# Phone camera (Android IP Camera app, default port 4444)
CAMERA_URL=https://192.168.1.63:4444/video/mjpeg
CAMERA_USER=
CAMERA_PASSWORD=
# The app uses a self-signed certificate on the LAN.
CAMERA_VERIFY_TLS=false

# Power switch: dryrun | shelly | cync
PLUG_KIND=dryrun
# Shelly: the plug's IP address
PLUG_HOST=
# Cync: the plug's name in the Cync app (blank = the only plug). Log in once with scripts/cync_login.py.
PLUG_NAME=

# Safety tuning (inches / seconds)
DEFAULT_CLEARANCE_IN=36
WATCH_MARGIN_IN=6
DWELL_HIGH_S=10
DWELL_MEDIUM_S=20
DWELL_LOW_S=60
FAILSAFE_ENABLED=true
FAILSAFE_AFTER_S=30

# Spend cap for Meta API calls
BUDGET_USD_PER_HOUR=5
