# Copy to .env and fill in. .env is git-ignored.

# Meta Model API (https://dev.meta.ai)
MODEL_API_KEY=
META_API_BASE=https://api.meta.ai/v1
DISPLAY_TIMEZONE=America/New_York
# Camera/local tracking freshness; model verification has a separate deadline.
PERCEPTION_MAX_AGE_S=5
# Recheck with SAM every 30s, or earlier for scene changes/lost tracks.
PERCEPTION_IDLE_REFRESH_S=30
PERCEPTION_VERIFICATION_MAX_AGE_S=45
PERCEPTION_INVENTORY_REFRESH_S=60

# Phone camera (Android IP Camera app, default port 4444)
CAMERA_URL=https://192.168.1.63:4444/video/mjpeg
CAMERA_USER=
CAMERA_PASSWORD=
# The app uses a self-signed certificate on the LAN.
CAMERA_VERIFY_TLS=false

# Power switch: dryrun (simulated) | cync (GE Cync plug)
PLUG_KIND=cync
# Cync: the plug's name in the Cync app (blank = the only plug). Log in once with scripts/cync_login.py.
PLUG_NAME='Heater'

# Safety tuning (inches / seconds)
# Clearance on every side until a rule is approved; also the suggested floor for manual readings.
DEFAULT_CLEARANCE_IN=15
# Fixed amber band outside the red zone; measurement error does not expand it.
WATCH_MARGIN_IN=2
DWELL_HIGH_S=10
DWELL_MEDIUM_S=20
DWELL_LOW_S=60
FAILSAFE_ENABLED=true
FAILSAFE_AFTER_S=30
OFF_COMMAND_RETRIES=2

# Spend cap for Meta API calls
BUDGET_USD_PER_HOUR=5
